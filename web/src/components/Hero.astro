---
import { links } from '../data/site';
---

<section class="hero">
  <p class="eyebrow">Open source, from FRC Team 1939</p>
  <h1>Scouting software for FRC teams.</h1>
  <p class="lede">
    Collect match and pit data on your team's phones, sync it without venue Wi-Fi, and turn it into
    stats your drive team can use.
  </p>
  <div class="actions">
    <a class="btn btn-primary" href={links.github}>View on GitHub</a>
    <a class="btn btn-secondary" href={links.docs}>Read the docs</a>
  </div>
</section>

<style>
  .hero {
    max-width: 880px;
    margin-inline: auto;
    padding: var(--section-space) var(--gutter) clamp(48px, 6vw, 72px);
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-2);
  }

  h1 {
    font-size: clamp(42px, 6.4vw, 76px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    max-width: 600px;
    margin: 24px auto 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
