---
import { screenshots } from '../data/site';
---

<section class="container" aria-label="Product preview">
  <div class="stage">
    {
      screenshots.map((name) => (
        <div class="phone" role="img" aria-label={`Placeholder for a screenshot of ${name}`}>
          <span class="name">{name}</span>
          <span class="note">Screenshot placeholder</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stage {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    padding: clamp(24px, 5vw, 56px) clamp(16px, 4vw, 56px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 256px;
    height: 540px;
    padding: 24px;
    border: 1px solid var(--color-border-strong);
    border-radius: 32px;
    background: var(--color-bg);
    text-align: center;
  }

  .name {
    font-weight: 500;
  }

  .note {
    font-size: 14px;
    color: var(--color-ink-3);
  }
</style>
