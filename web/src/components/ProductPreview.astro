---
import { Image } from 'astro:assets';
import { screenshots } from '../data/site';
---

<section class="container" aria-label="Product preview">
  <div class="stage">
    {
      screenshots.map((screen) => (
        <figure>
          <Image
            src={screen.image}
            alt={screen.alt}
            widths={[256, 512]}
            sizes="256px"
            format="webp"
          />
          <figcaption>{screen.name}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .stage {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    padding: clamp(24px, 5vw, 56px) clamp(16px, 4vw, 56px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  figure {
    width: 256px;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border-strong);
    border-radius: 32px;
  }

  figcaption {
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    color: var(--color-ink-2);
  }
</style>
