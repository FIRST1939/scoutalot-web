---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { links } from '../data/site';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/">
      <Image src={logo} alt="" height={28} densities={[1, 2]} format="webp" loading="eager" />
      Scout a Lot
    </a>
    <nav aria-label="Main">
      <a class="nav-link" href="/#features">Features</a>
      <a class="nav-link" href="/#availability">Download</a>
      <a class="nav-link" href={links.docs}>Docs</a>
      <a class="github" href={links.github}>GitHub</a>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 12px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
    font-size: 14px;
    color: var(--color-ink-2);
  }

  .nav-link {
    padding-block: 10px;
  }

  .github {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 16px;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-weight: 500;
  }
</style>
